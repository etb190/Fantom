<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Fantom.Views.Dialogs.MessageBox"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="White"
        FontFamily="fonts:Inter#Inter, Segoe UI, Helvetica Neue, Arial, sans-serif">

  <StackPanel Margin="26,24,26,22" Spacing="14">
    <TextBlock x:Name="TitleText" Text="" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
    <TextBlock x:Name="MessageText" Text="" FontSize="13.5" Foreground="#475467" TextWrapping="Wrap" LineHeight="21" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Classes="ghost" Click="OnCancel" Width="90" Height="38" />
      <Button x:Name="ConfirmButton" Content="OK" Classes="pill" Click="OnConfirm" Width="90" Height="38" />
    </StackPanel>
  </StackPanel>
</Window>
